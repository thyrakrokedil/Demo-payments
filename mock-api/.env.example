# HTTP Basic auth credentials required on /payments* (GET /health is public).
# The password is also the API key that signs callbacks (X-MockPay-Signature).
AUTH_USERNAME=username
AUTH_PASSWORD=password

# Base URL customers' browsers reach MockPay on; used for payment_page_url
PUBLIC_URL=http://localhost:8888

# Timeout in seconds for each validation/notification callback to the merchant
CALLBACK_TIMEOUT_SECONDS=5

# Path to the SQLite database file (use ":memory:" for an ephemeral DB)
DB_PATH=/var/data/mockpay.sqlite

# Apply pending SQL migrations from database/migrations on startup
DB_MIGRATE_ON_BOOT=true

# Include exception details in 500 responses
APP_DEBUG=false

# Monolog level: debug|info|notice|warning|error
LOG_LEVEL=info

# Number of PHP built-in server workers
PHP_CLI_SERVER_WORKERS=4
