{
    "name": "mockpay/mock-payment-provider",
    "description": "Local mock payment provider REST API for testing e-commerce integrations",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-pdo_sqlite": "*",
        "slim/slim": "^4.14",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "php-di/php-di": "^7.0",
        "monolog/monolog": "^3.0",
        "psr/log": "^3.0",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0",
        "psr/http-factory": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "MockPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MockPay\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "stan": "phpstan analyse --memory-limit=512M",
        "migrate": "php bin/migrate",
        "serve": "php -S 0.0.0.0:8888 -t public public/index.php"
    }
}
