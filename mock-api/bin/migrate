#!/usr/bin/env php
<?php

declare(strict_types=1);

use MockPay\Infrastructure\Persistence\PdoFactory;
use MockPay\Infrastructure\Persistence\SqliteMigrator;

require __DIR__ . '/../vendor/autoload.php';

$dbPath = getenv('DB_PATH');

if (! is_string($dbPath) || $dbPath === '') {
    $dbPath = __DIR__ . '/../data/mockpay.sqlite';
}

$pdo = PdoFactory::create($dbPath);
$migrator = new SqliteMigrator($pdo, __DIR__ . '/../database/migrations');

$applied = $migrator->migrate();

if ($applied === []) {
    echo 'Nothing to migrate.' . \PHP_EOL;
} else {
    foreach ($applied as $version) {
        echo 'Applied: ' . $version . \PHP_EOL;
    }
}

exit(0);
