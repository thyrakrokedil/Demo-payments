<?xml version="1.0"?>
<ruleset name="Krokedil Demo Payments">
    <file>.</file>
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>mock-api/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg value="sp"/>
    <rule ref="WordPress"/>
</ruleset>
